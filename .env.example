# TallyNX Web Environment Configuration Example
# Copy to `.env.local` for local development. Never commit real secrets.

# Server runtime port (local Express server)
PORT=3000

# Gemini API key for TallyNX Advisor (/api/advisor, /api/chat)
GEMINI_API_KEY=

# Shared Upstash Redis REST credentials for global site traffic counters (/api/telemetry/traffic)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional fallback hub URL when Upstash Redis is not configured directly on this deployment
# TALLYNX_TRAFFIC_HUB_URL=https://desk.tallynx.com/api/telemetry/traffic

# Cross-subdomain SSO HMAC signing secret (min 16 chars)
TALLYNX_SSO_SECRET=

# Internal service key required to mint SSO handoff tokens via POST /api/auth/sso-handoff (min 16 chars)
# Passed in X-TallyNX-Internal-Key or Authorization: Bearer <key>
TALLYNX_SSO_MINT_KEY=

# Optional ecosystem app base URLs
TALLYNX_DESK_APP_URL=https://desk.tallynx.com/
VITE_TREDYN_MALL_URL=https://mall.tallynx.com/
